---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <title>{title}</title>
    <link rel="icon" type="image/png" href="./favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="keywords"
      content="LABEYE Loïc, Rust, Javascript, TotalEnergies, Allianz Trade, NextJS, Python, Web, Software Engineer, Azure, AWS, Cloud, Microsoft"
    />
    <meta
      name="description"
      content="This website showcases Loïc LABEYE's personal experiences and projects."
    />
    <meta name="robots" content="index, follow" />
    <link rel="robots" href="./robots.txt" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,100..900&family=JetBrains+Mono:wght@400;700&display=swap" rel="stylesheet" />
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-154TP6TJRZ"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-154TP6TJRZ');
    </script>
  </head>
  <body class="min-h-screen bg-zinc-950 text-zinc-100 font-['Inter',sans-serif] overflow-x-hidden relative">
    <!-- Gradient mesh background -->
    <div class="fixed inset-0 -z-10 overflow-hidden">
      <div class="absolute top-[-20%] left-[-10%] w-[600px] h-[600px] rounded-full bg-violet-600/15 blur-[120px] animate-drift"></div>
      <div class="absolute bottom-[-20%] right-[-10%] w-[500px] h-[500px] rounded-full bg-indigo-600/10 blur-[100px] animate-drift-slow"></div>
      <div class="absolute top-[40%] right-[20%] w-[300px] h-[300px] rounded-full bg-fuchsia-600/8 blur-[80px] animate-drift"></div>
    </div>

    <!-- Grain overlay -->
    <div class="fixed inset-0 -z-5 pointer-events-none opacity-[0.025] animate-grain" style="background-image: url('data:image/svg+xml,%3Csvg viewBox=%220 0 200 200%22 xmlns=%22http://www.w3.org/2000/svg%22%3E%3Cfilter id=%22noise%22%3E%3CfeTurbulence type=%22fractalNoise%22 baseFrequency=%220.85%22 numOctaves=%224%22 stitchTiles=%22stitch%22/%3E%3C/filter%3E%3Crect width=%22100%25%22 height=%22100%25%22 filter=%22url(%23noise)%22/%3E%3C/svg%3E'); background-size: 200px 200px;"></div>

    <!-- Scroll progress -->
    <div id="progressBar" class="fixed top-0 left-0 h-[2px] bg-gradient-to-r from-violet-500 to-indigo-500 z-50 transition-[width] duration-100 ease-out" style="width: 0%;"></div>

    <div class="relative z-10">
      <slot />
    </div>

    <script>
      const progressBar = document.getElementById('progressBar');
      window.addEventListener('scroll', () => {
        const totalHeight = document.body.scrollHeight - window.innerHeight;
        const progress = (window.scrollY / totalHeight) * 100;
        if (progressBar) progressBar.style.width = `${progress}%`;
      });
    </script>
    <script>
      import '../scripts/analytics.ts';
    </script>
    <script>
      import '../scripts/reveal.ts';
    </script>
    <script>
      import '../scripts/i18n.ts';
    </script>
  </body>
</html>
