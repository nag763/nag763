---
const { tech } = Astro.props;
---

<div class="flex flex-col items-center group cursor-default">
  <div class="p-3 rounded-xl border border-transparent group-hover:border-violet-500/20 group-hover:bg-violet-500/5 transition-all duration-300">
    <img
      src={`https://cdn.simpleicons.org/${tech.icon}/71717a`}
      alt={tech.name}
      class="w-8 h-8 grayscale-50 opacity-70 group-hover:grayscale-0 group-hover:opacity-100 group-hover:brightness-150 transition-all duration-300 group-hover:scale-110"
    />
  </div>
  <span class="text-[10px] font-['JetBrains_Mono'] text-zinc-600 uppercase tracking-tighter mt-2 opacity-0 group-hover:opacity-100 transition-opacity duration-300">
    {tech.name}
  </span>
</div>
