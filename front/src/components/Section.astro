---
interface Props {
  title: string;
  trackName?: string;
}

const { title, trackName } = Astro.props;
---

<section class="space-y-12" data-track-section={trackName}>
  <h2 class="text-xs font-bold text-violet-400 uppercase tracking-[0.25em] font-['JetBrains_Mono'] reveal">{title}</h2>
  <slot />
</section>
