---
const { certification } = Astro.props;
---

<a
  href={certification.link}
  target="_blank"
  rel="noopener noreferrer"
  data-track-event="certification_click"
  data-track-label={certification.title}
  class="group block p-4 rounded-xl border border-zinc-800/50 bg-white/[0.02] hover:bg-white/[0.05] hover:border-violet-500/30 transition-all duration-300"
>
  <p class="text-[10px] font-['JetBrains_Mono'] text-zinc-600 mb-1.5">{certification.authority} • {certification.earned_on}</p>
  <h4 class="text-sm font-bold text-zinc-300 group-hover:text-violet-300 leading-tight transition-colors duration-300">{certification.title}</h4>
</a>
