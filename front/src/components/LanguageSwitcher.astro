---
import { locales, localeNames } from '../i18n/translations';
---

<div class="fixed top-4 right-4 z-50 flex gap-1 p-1 rounded-full border border-zinc-800 bg-zinc-950/80 backdrop-blur-sm">
  {locales.map(locale => (
    <button
      data-locale={locale}
      class="px-2.5 py-1 rounded-full text-[11px] font-bold font-['JetBrains_Mono'] uppercase tracking-wider border transition-all duration-200 cursor-pointer text-zinc-500 border-zinc-800 hover:text-zinc-300"
    >
      {localeNames[locale]}
    </button>
  ))}
</div>
