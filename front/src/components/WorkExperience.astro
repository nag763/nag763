---
const { experience } = Astro.props;

const dotClasses = [
  'absolute w-3 h-3 rounded-full -left-[7px] top-2',
  experience.current
    ? 'bg-violet-500 shadow-[0_0_12px_rgba(139,92,246,0.8)] animate-pulse'
    : 'bg-zinc-700'
].join(' ');
---

<div class="relative pl-8 border-l border-zinc-800/50 group">
  <div class={dotClasses}></div>
  <div class="flex flex-wrap justify-between items-baseline mb-2">
    <h3 class="text-xl font-bold text-white group-hover:text-violet-300 transition-colors duration-300">{experience.title}</h3>
    <span class="text-zinc-600 font-['JetBrains_Mono'] text-sm">{experience.period}</span>
  </div>
  <p class="text-zinc-600 mb-4 italic text-sm">{experience.location}</p>
  <ul class="text-zinc-400 text-base space-y-2 max-w-3xl leading-relaxed">
    {experience.tasks.map((task: string) => (
      <li class="flex gap-3">
        <span class="text-violet-500 mt-1.5 flex-shrink-0">▸</span>
        <span>{task}</span>
      </li>
    ))}
  </ul>
  <div class="mt-4 flex flex-wrap gap-2">
    {experience.technologies.map((t: string) => (
      <span class="text-[10px] border border-zinc-800 text-zinc-500 px-2.5 py-1 rounded-full uppercase font-bold tracking-widest hover:border-violet-500/30 hover:text-violet-400 transition-colors duration-200">{t}</span>
    ))}
  </div>
</div>
